# ============================================================
# SeguriCRM - Environment Variables Template
# Copy this file to .env.local and fill in the values
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Do NOT change these if already configured
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@host:5432/postgres

# ── JWT Secrets ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# ── Super Admin (for db:seed:prod) ───────────────────────────
INITIAL_SUPER_ADMIN_EMAIL=admin@seguricrm.com
INITIAL_SUPER_ADMIN_PASSWORD=ChangeMeImmediately!
INITIAL_SUPER_ADMIN_NAME=Super Administrador

# ── Registration Control ──────────────────────────────────────
# Set to "false" to disable public registration
REGISTRATION_ENABLED=false

# ── Next.js ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
